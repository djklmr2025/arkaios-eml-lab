{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARKAIOS_GLYPH_Graph_v1",
  "description": "JSON Schema versioned for ARKAIOS-GLYPH transformation graphs (DAGs).",
  "type": "object",
  "required": ["version", "graph_id", "nodes", "root_id"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "graph_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "root_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string" },
        "author": { "type": "string" },
        "layer": { "type": "string" }
      }
    }
  },
  "definitions": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "inputs", "domain"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "CONSTANT",
            "VARIABLE",
            "EML",
            "COMBINE",
            "TRANSFORM",
            "SIGNAL",
            "RESULT",
            "PROVENANCE"
          ]
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "object"
        },
        "domain": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "constraints": { "type": "array", "items": { "type": "string" } },
            "singularities": { "type": "array", "items": { "type": "string" } }
          }
        },
        "result": {
          "description": "Cached evaluation result (scalar, complex, or symbolic representation)"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "trace_id": { "type": "string" },
            "operation": { "type": "string" },
            "relation": { "type": "string" },
            "causal_parents": { "type": "array", "items": { "type": "string" } },
            "hash": { "type": "string" }
          }
        },
        "visual_repr": {
          "type": "object",
          "description": "Explicit visual depiction decoupling symbol graphics from semantics"
        }
      }
    }
  }
}
